# این فایل را کپی کنید به .env و مقادیر را با اطلاعات خودتان پر کنید
# cp .env.example .env

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///yazarvpn.db

# --- تنظیمات تلگرام ---
# توکن بات را از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere
# chat_id خودتان یا گروه/کانالی که پیام سفارش‌ها باید به آن ارسال شود
TELEGRAM_ADMIN_CHAT_ID=123456789
# یوزرنیم کانال/آیدی تلگرام برای دکمه "ارتباط با ما" (بدون @)
TELEGRAM_CHANNEL_USERNAME=Yazarvpn

# --- ورود پنل ادمین ---
ADMIN_USERNAME=admin
# هش پسورد را با دستور زیر بسازید:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourStrongPassword'))"
ADMIN_PASSWORD_HASH=

# --- سایت ---
SITE_NAME=YazarVPN
SITE_CURRENCY=تومان
